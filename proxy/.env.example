# AuraLearn stateless proxy — environment template.
#
# Copy to `.env` for LOCAL DEV ONLY. `.env` is gitignored and must NEVER be committed.
# In production the key is injected at runtime from the host secrets manager
# (Fly.io secrets / Render env-group / Cloud Run Secret Manager) — NOT a committed file.
# NEVER put a real key in this file. The placeholder below stays blank in git.

# --- Secrets (runtime-injected in prod) ---
ANTHROPIC_API_KEY=

# --- Model routing (Phase A Step 0 verified IDs; do NOT hardcode in logic) ---
# free  -> Haiku 4.5 (vision-capable, cheapest)
# paid  -> Sonnet 4.6 (standard) / Opus 4.8 (pro)
MODEL_FREE=claude-haiku-4-5-20251001
MODEL_PAID_STD=claude-sonnet-4-6
MODEL_PAID_PRO=claude-opus-4-8

# --- Server ---
PORT=8787

# --- Metering store (abuse/rate guard only — NOT entitlement) ---
# Leave REDIS_URL blank to use the in-memory store (single-instance dev/test).
# Set it (e.g. redis://localhost:6379) to use the Redis store in production.
REDIS_URL=
FREE_DAILY_QUOTA=3

# --- Auth (Phase C: real account-JWT verification) ---
# HS256 shared secret used to verify account JWTs issued by the accounts service.
# The token conveys IDENTITY ONLY (userId from `sub`) — never the plan. The plan is
# resolved server-side from the entitlement store. REQUIRED in production.
ACCOUNTS_JWT_SECRET=

# Dev fallback token (LOCAL DEV ONLY). If set, `Authorization: Bearer <DEV_AUTH_TOKEN>`
# (and `<DEV_AUTH_TOKEN>:<label>` for multiple test users) is accepted WITHOUT JWT
# verification. Leave BLANK in production so only real account JWTs are accepted.
DEV_AUTH_TOKEN=dev-local-token

# --- IAP receipt validation (Phase C) ---
# REAL receipt verification needs YOUR store credentials. When these are absent, a
# deterministic MOCK verifier is used (also used by tests). Supply these in prod.
# Apple App Store Server API:
APPLE_IAP_SHARED_SECRET=
APPLE_IAP_ISSUER_ID=
# Google Play Developer API service-account JSON (the whole JSON, or a path your
# deployment reads — wire it in lib/receipt-verifier.ts):
GOOGLE_PLAY_SA_JSON=

# --- Doc-context (context-stuffing) ---
# Max characters of imported-document `context` stuffed into the upstream request as
# REFERENCE material (truncated past this; never treated as instructions).
MAX_CONTEXT_CHARS=12000
