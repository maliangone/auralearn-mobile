# AuraLearn stateless proxy — environment template.
#
# Copy to `.env` for LOCAL DEV ONLY. `.env` is gitignored and must NEVER be committed.
# In production the key is injected at runtime from the host secrets manager
# (Fly.io secrets / Render env-group / Cloud Run Secret Manager) — NOT a committed file.
# NEVER put a real key in this file. The placeholder below stays blank in git.

# --- Secrets (runtime-injected in prod) ---
# Per-provider connection settings, shared by all tiers that use that provider.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model routing (per tier; env-driven, do NOT hardcode in logic) ---
#
# Default stack (no env set): every tier -> OpenAI gpt-5.6-luna with
# reasoning_effort=max (vision photo-solving lane).
#
# Legacy MODEL_* vars still work: setting them selects the ANTHROPIC provider
# with those model IDs (backward compatible with Phase A0 configs).
#
# Per-tier overrides:
#   {FREE|STD|PRO}_PROVIDER=anthropic|openai
#   {FREE|STD|PRO}_MODEL=<model id>
#   {FREE|STD|PRO}_REASONING_EFFORT=none|low|medium|high|xhigh|max  ("" = omit)
#   {FREE|STD|PRO}_SUPPORTS_VISION=true|false
#       (auto-inferred: deepseek base URL => false; set explicitly to override)
#
# Example — photo lane on GPT-5.6 Luna (default) and a text-only DeepSeek
# standard tier (images on that tier are rejected with `model_no_vision`):
#   STD_PROVIDER=openai
#   STD_MODEL=deepseek-chat
#   OPENAI_BASE_URL=https://api.deepseek.com   # note: applies to ALL openai tiers
#
# Legacy anthropic routing (kept for compatibility):
# MODEL_FREE=claude-haiku-4-5-20251001
# MODEL_PAID_STD=claude-sonnet-4-6
# MODEL_PAID_PRO=claude-opus-4-8

# --- Server ---
PORT=8787

# --- Metering store (abuse/rate guard only — NOT entitlement) ---
# With FIREBASE_PROJECT_ID set, metering + entitlement persist in Firestore
# (server-authoritative). Without it, in-memory stores (dev/test only —
# restart loses counters/entitlement).
FREE_DAILY_QUOTA=3

# --- Auth (Phase 3: Firebase ID tokens) ---
# The Firebase project id. When set, the proxy verifies Firebase ID tokens via
# firebase-admin (ADC on Cloud Run; GOOGLE_APPLICATION_CREDENTIALS or
# FIREBASE_CREDENTIALS_PATH locally) and uses Firestore for metering +
# entitlement. Blank => in-memory stores + dev/legacy auth only.
FIREBASE_PROJECT_ID=

# Dev fallback token (LOCAL DEV ONLY). If set, `Authorization: Bearer <DEV_AUTH_TOKEN>`
# (and `<DEV_AUTH_TOKEN>:<label>` for multiple test users) is accepted WITHOUT
# verification. Leave BLANK in production so only real Firebase ID tokens pass.
DEV_AUTH_TOKEN=dev-local-token

# Legacy HS256 JWT secret (dev/tooling compatibility; not needed once Firebase
# auth is wired). Token conveys IDENTITY ONLY (`sub` → userId) — never the plan.
ACCOUNTS_JWT_SECRET=

# --- RevenueCat (Phase 3: subscriptions) ---
# The proxy queries RevenueCat itself (GET /v1/subscribers/{uid}); clients never
# send receipts. The webhook endpoint /webhook/revenuecat is protected by the
# static secret AND an HMAC signature.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_HMAC_SECRET=

# --- Doc-context (context-stuffing) ---
# Max characters of imported-document `context` stuffed into the upstream request as
# REFERENCE material (truncated past this; never treated as instructions).
MAX_CONTEXT_CHARS=12000
