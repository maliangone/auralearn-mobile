{
  "name": "auralearn-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless LLM proxy for AuraLearn — forwards K-12 tutor solve/chat requests to Anthropic, stores no user content, meters per-user usage as an abuse guard, and routes model by plan. Phase A0.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "verify-models": "tsx scripts/verify-models.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "fastify": "^5.2.0",
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
